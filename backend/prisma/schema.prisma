  OutputTokenCostUsd Decimal?  @default(0.00000000) @db.Decimal(10, 8)

  @@index([CreatedAt], map: "idx_ai_token_usage_created_at")
  @@index([Email], map: "idx_ai_token_usage_email")
  @@index([OperationType], map: "idx_ai_token_usage_operation_type")

  CreatedAt          DateTime? @default(now())
  InputTokenCost     Decimal?  @default(0.00000000) @db.Decimal(10, 8)
  OutputTokenCost    Decimal?  @default(0.00000000) @db.Decimal(10, 8)
  TotalTokenCost     Decimal?  @default(0.00000000) @db.Decimal(10, 8)

// Local MySQL schema for wellness_schema_check.
// Live API traffic still uses Supabase. Regenerate with: npm run prisma:pull

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model activity_report_hidden_users_table {
  Id           BigInt   @id @default(autoincrement())
  ViewerUserId BigInt
  HiddenUserId BigInt
  IsHidden     Boolean  @default(true)
  CreatedAt    DateTime @default(now())
  UpdatedAt    DateTime @default(now())

  @@unique([ViewerUserId, HiddenUserId], map: "activity_report_hidden_users_viewer_hidden_unique")
}

model activity_time_windows_table {
  Id                Int       @id @default(autoincrement())
  ActivityType      String    @db.VarChar(50)
  WindowStartTime   DateTime  @db.Time(0)
  WindowEndTime     DateTime  @db.Time(0)
  EffectiveFromDate DateTime
  EffectiveToDate   DateTime?
  ChangedBy         String?   @db.VarChar(100)
  ChangeReason      String?   @db.LongText
  CreatedAt         DateTime? @default(now())

  @@index([ActivityType, EffectiveFromDate, EffectiveToDate], map: "idx_activity_time_windows_activity_effective")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_analysis_jobs_table {
  JobId                     String                     @id @default(dbgenerated("(uuid())")) @db.Char(36)
  CaptureId                 String                     @db.VarChar(64)
  UserID                    Int?
  TraceId                   String                     @db.Char(36)
  MimeType                  String                     @default("image/jpeg") @db.VarChar(64)
  FastNutrition             Json?
  FoodRowId                 Int?
  Status                    String                     @default("pending") @db.VarChar(20)
  RetryCount                Int                        @default(0) @db.SmallInt
  LastError                 String?                    @db.LongText
  EnrichmentResult          Json?
  CreatedAt                 DateTime                   @default(now())
  UpdatedAt                 DateTime                   @default(now())
  IsDeleted                 Int                        @default(0) @db.SmallInt
  food_nutrition_data_table food_nutrition_data_table? @relation(fields: [FoodRowId], references: [ID], onUpdate: NoAction)
  team_table                team_table?                @relation(fields: [UserID], references: [UserId], onDelete: Cascade, onUpdate: NoAction)

  @@index([FoodRowId], map: "ai_analysis_jobs_table_FoodRowId_fkey")
  @@index([UserID], map: "ai_analysis_jobs_table_UserID_fkey")
  @@index([CaptureId], map: "idx_ai_jobs_capture")
  @@index([Status, CreatedAt], map: "idx_ai_jobs_status_created")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_credits_config_table {
  id                   BigInt   @id @default(autoincrement())
  daily_ai_credits     Int      @default(3)
  ai_mode_enabled      Boolean  @default(true)
  updated_at           DateTime @default(now())
  updated_by_user_id   BigInt?
  availability_windows Json     @default(dbgenerated("(cast(_utf8mb4\\'{\"lunch\":{\"end\":\"16:00:00\",\"start\":\"12:00:00\",\"enabled\":true},\"dinner\":{\"end\":\"20:30:00\",\"start\":\"17:30:00\",\"enabled\":true},\"breakfast\":{\"end\":\"08:30:00\",\"start\":\"05:30:00\",\"enabled\":true}}\\' as json))"))
}


{
  "name": "wellness-valley-pwa-backend",
  "version": "3.4.9",
  "private": true,
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.90.1",
    "@vercel/functions": "^1.6.0",
    "ai-token-monitor": "^1.0.10",
    "bcryptjs": "^3.0.2",
    "formidable": "^3.5.4",
    "joi": "^18.2.1",
    "luxon": "^3.7.2",
    "next": "^16.3.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first next dev",
    "dev:local": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "start:local": "next start --port 3000",
    "backfill:avatars": "node --env-file=.env scripts/backfill-avatar-r2.js",
    "backfill:avatars:write": "node --env-file=.env scripts/backfill-avatar-r2.js --write",
    "backfill:avatars:recompress": "node --env-file=.env scripts/backfill-avatar-r2.js --recompress",
    "backfill:avatars:recompress:write": "node --env-file=.env scripts/backfill-avatar-r2.js --recompress --write",
    "backfill:avatars:cleanup": "node --env-file=.env scripts/backfill-avatar-r2.js --cleanup",
    "backfill:avatars:cleanup:write": "node --env-file=.env scripts/backfill-avatar-r2.js --cleanup --write",
    "backfill:food-images": "node --env-file=.env scripts/backfill-food-r2.js",
    "backfill:food-images:write": "node --env-file=.env scripts/backfill-food-r2.js --write"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0"
  }
}

    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
    "@capgo/capacitor-navigation-bar": "^8.2.6",
    "@ionic/react": "^8.6.4",
    "@southdevs/capacitor-google-auth": "^7.0.0",
    "axios": "^1.13.2",
    "date-fns": "^2.30.0",
    "firebase": "^9.23.0",
    "framer-motion": "^12.23.3",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.525.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7",
    "react-router-dom": "^6.30.2",
    "react-scripts": "5.0.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "ajv": "^8.8.2",
    "autoprefixer": "^10.4.14",
    "eslint": "^10.5.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "node update-sw-version.js",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "android:clean": "cd android && gradlew.bat clean",
    "android:assembleDebug": "cd android && gradlew.bat assembleDebug",
    "android:fullbuild": "npm run build && npx cap sync android && npm run android:clean && npm run android:assembleDebug",
    "android:test-cache": "npm run build && echo === Cache Version Updated === && npx cap sync android && echo === Ready to test debug APK ==="
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "ajv-keywords": {
      "ajv": "^8.8.2"
    }
  }
}
